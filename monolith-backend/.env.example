DATABASE_URL="postgresql://postgres:postgres@localhost:5433/flowpilot?schema=public"
PORT=8080
JWT_SECRET="flowpilot-secret-key-for-jwt-signing-minimum-32-chars"

# ============================================================================
# Redis Configuration (for OTP caching & fast key-value storage)
# ============================================================================
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_PASSWORD=""

# ============================================================================
# SMTP Email Configuration (for OTP verification & password reset)
# ============================================================================
# Option 1: Local testing with MailHog (docker-compose up -d mailhog):
# SMTP_HOST="localhost"
# SMTP_PORT=1025
# SMTP_SECURE=false
# SMTP_USER=""
# SMTP_PASS=""
# SMTP_FROM="FlowPilot <no-reply@flowpilot.io>"
# (View sent emails at http://localhost:8025)
#
# Option 2: Production / Real Gmail:
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER="your-email@gmail.com"
# SMTP_PASS="your-16-char-app-password"  # Google Account -> Security -> 2-Step Verification -> App passwords
# SMTP_FROM="FlowPilot <your-email@gmail.com>"

SMTP_HOST="localhost"
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="FlowPilot <no-reply@flowpilot.io>"

LLM_MAX_ITEMS=500

# Public address outside callers use (e.g. a cloudflared tunnel): webhook URLs
# (/api/webhooks/<id>) and the OAuth2 redirect URL (/api/oauth2/callback) shown
# in the designer. Defaults to http://localhost:$PORT. Apps such as Facebook
# Messenger are configured in the UI (credential with your own App ID /
# Secret), not here: docs/setup/messenger.md.
# PUBLIC_BASE_URL=https://flowpilot.example.com

# Background executions (webhook runs, BullMQ on the Redis above)
EXECUTION_CONCURRENCY=5
# RUNNING executions older than this are marked FAILED on startup.
EXECUTION_STALE_MINUTES=15
# BullMQ key prefix; give each environment sharing a Redis its own.
# BULLMQ_PREFIX=bull

# HTTP Request node: workflows may not call private or internal addresses (localhost,
# 10.x, 192.168.x, cloud metadata). Set to true only on a development machine.
# HTTP_REQUEST_ALLOW_PRIVATE=false

# 32 bytes as 64 hex chars (e.g. openssl rand -hex 32). Needed to store credentials (Google OAuth tokens, LLM API keys).
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ENCRYPTION_KEY=

google-Client-Id=<client id lấy từ Google Cloud>
google-Client-secret=<client secret>
GOOGLE_REDIRECT_URI=http://localhost:8081/api/integrations/google/callback