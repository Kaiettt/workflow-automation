{
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "resolvePackageJsonExports": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2023",
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": "./",
    "paths": {
      "@app/designer": ["libs/designer/src"],
      "@app/designer/*": ["libs/designer/src/*"],
      "@app/execution": ["libs/execution/src"],
      "@app/execution/*": ["libs/execution/src/*"],
      "@app/connector": ["libs/connector/src"],
      "@app/connector/*": ["libs/connector/src/*"],
      "@app/monitoring": ["libs/monitoring/src"],
      "@app/monitoring/*": ["libs/monitoring/src/*"],
      "@app/versioning": ["libs/versioning/src"],
      "@app/versioning/*": ["libs/versioning/src/*"],
      "@app/logging": ["libs/logging/src"],
      "@app/logging/*": ["libs/logging/src/*"],
      "@app/shared": ["libs/shared/src"],
      "@app/shared/*": ["libs/shared/src/*"],
      "@app/database": ["libs/database/src"],
      "@app/database/*": ["libs/database/src/*"],
      "@app/auth": ["libs/auth/src"],
      "@app/auth/*": ["libs/auth/src/*"],
      "@app/integrations": ["libs/integrations/src"],
      "@app/integrations/*": ["libs/integrations/src/*"]
    },
    "incremental": true,
    "skipLibCheck": true,
    "strictNullChecks": true,
    "forceConsistentCasingInFileNames": true,
    "noImplicitAny": false,
    "strictBindCallApply": false,
    "noFallthroughCasesInSwitch": false
  }
}
